<core:FragmentDefinition 
	xmlns:core="sap.ui.core"
	xmlns="sap.m" 
	xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
    	xmlns:fb="sap.ui.comp.filterbar" 
	xmlns:u="sap.ui.unified"
	xmlns:html="http://www.w3.org/1999/xhtml"
   
	>
	<Dialog contentWidth="60%" showHeader="false" draggable="true" title="Enviar" >
		<content >
        		<VBox class="sapUiSmallMargin">
		<f:SimpleForm id="SimpleFormChange354"
			editable="true"
			layout="ResponsiveGridLayout"
			title="Respuesta"
			labelSpanXL="3"
			labelSpanL="3"
			labelSpanM="3"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="4"
			emptySpanL="4"
			emptySpanM="4"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="false" >
			<f:content>
		
               	 
                <Label text="Respuesta" />
                 <TextArea value="{context>/responseLegales/comentario}" rows="3"></TextArea>
	
		
			</f:content>
		</f:SimpleForm>
	</VBox>
                               
	
	
		</content>
        <beginButton>
             <Button text="Enviar" type="Accept" press="onEnviarTaskResponse"></Button>
        </beginButton>
		<endButton>
           
			<Button text="Cerrar" type="Reject" press="onCloseDialogResponse"></Button>
		</endButton>
	</Dialog>
</core:FragmentDefinition>